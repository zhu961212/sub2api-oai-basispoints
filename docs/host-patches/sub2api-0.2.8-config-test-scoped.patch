+func TestPluginManagerTestScopedPinsClientAcrossRuntimeReplacement(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	oldClient := &scopedDiagnosticClient{valid: true}
+	newClient := &scopedDiagnosticClient{valid: true}
+	oldClient.validateFn = func(ctx context.Context) (*pluginv1.ValidateConfigResponse, error) {
+		close(entered)
+		select {
+		case <-release:
+			return &pluginv1.ValidateConfigResponse{Valid: true}, nil
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	oldClient.testFn = func(context.Context, []byte) (*pluginv1.TestConfigResponse, error) {
+		return nil, errors.New("captured runtime was stopped")
+	}
+	manager, _ := scopedDiagnosticManager(oldClient)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := manager.TestScoped(ctx, 9, "replaced-runtime", []byte(`{}`)); done <- err }()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("original validation did not enter")
+	}
+	manager.mu.Lock()
+	manager.runtimes[9].draining.Store(true)
+	manager.runtimes[9] = &pluginRuntime{api: newClient}
+	manager.mu.Unlock()
+	close(release)
+	require.ErrorContains(t, <-done, "captured runtime was stopped")
+	_, err := manager.TestScoped(context.Background(), 9, "replaced-runtime", []byte(`{}`))
+	require.ErrorContains(t, err, "captured runtime was stopped")
+	require.Equal(t, int32(1), oldClient.tests.Load())
+	require.Zero(t, newClient.validations.Load())
+	require.Zero(t, newClient.tests.Load())
+}
+
+func TestPluginManagerTestScopedRejectsDrainingOrMissingClient(t *testing.T) {
+	for _, state := range []string{"missing-runtime", "missing-client", "draining"} {
+		t.Run(state, func(t *testing.T) {
+			client := &scopedDiagnosticClient{valid: true}
+			manager, _ := scopedDiagnosticManager(client)
+			switch state {
+			case "missing-runtime":
+				delete(manager.runtimes, 9)
+			case "missing-client":
+				manager.runtimes[9].api = nil
+			case "draining":
+				manager.runtimes[9].draining.Store(true)
+			}
+			_, err := manager.TestScoped(context.Background(), 9, state, []byte(`{}`))
+			require.ErrorContains(t, err, "插件未运行")
+			require.Zero(t, client.validations.Load())
+			require.Zero(t, client.tests.Load())
+		})
+	}
+}
