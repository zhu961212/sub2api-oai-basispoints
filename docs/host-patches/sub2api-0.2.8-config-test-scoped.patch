+)
+
+type scopedHandlerRepository struct{ service.PluginRepository }
+
+func (*scopedHandlerRepository) GetByID(context.Context, int64) (*service.PluginInstallation, error) {
+	return &service.PluginInstallation{ID: 9}, nil
+}
+
+type scopedHandlerEncryptor struct{}
+
+func (scopedHandlerEncryptor) Encrypt(value string) (string, error) { return value, nil }
+func (scopedHandlerEncryptor) Decrypt(value string) (string, error) { return value, nil }
+
+func TestPluginScopedHandlerRejectsMalformedRequests(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	manager := service.NewPluginManager(&scopedHandlerRepository{}, scopedHandlerEncryptor{}, nil, service.PluginHostInfo{}, nil)
+	h := NewPluginHandler(manager)
+	router := gin.New()
+	router.POST("/plugins/:id/test-scoped", h.TestScoped)
+	for _, payload := range []string{
+		`null`, `{}`, `{"request_id":"valid-id","config":[]}`,
+		`{"request_id":"valid-id","config":null}`,
+		`{"request_id":"valid-id","config":{},"unknown":true}`,
+		`{"request_id":"bad id","config":{}}`,
+		`{"request_id":"valid-id","config":{}} {}`,
+	} {
+		t.Run(payload, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			router.ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, "/plugins/9/test-scoped", strings.NewReader(payload)))
+			require.Equal(t, http.StatusBadRequest, recorder.Code, recorder.Body.String())
+		})
+	}
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, "/plugins/9/test-scoped", strings.NewReader(`{"request_id":"valid-id","config":{}}`)))
+	require.Equal(t, http.StatusBadRequest, recorder.Code)
+	require.Contains(t, recorder.Body.String(), "插件未运行")
+}
+
+func TestPluginUISessionAdvertisesScopedTestingCapability(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	manager := service.NewPluginManager(&scopedHandlerRepository{}, scopedHandlerEncryptor{}, nil, service.PluginHostInfo{}, nil)
+	router := gin.New()
+	router.POST("/plugins/:id/ui-session", NewPluginHandler(manager).CreateUISession)
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, "/plugins/9/ui-session", nil))
+	require.Equal(t, http.StatusOK, recorder.Code)
+	var response struct {
+		Data struct {
+			Capabilities  []string `json:"capabilities"`
+			BridgeVersion int      `json:"ui_bridge_version"`
+			BridgeToken   string   `json:"bridge_token"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &response))
+	require.Equal(t, 1, response.Data.BridgeVersion)
+	require.Equal(t, []string{"config.testScoped"}, response.Data.Capabilities)
+	require.NotEmpty(t, response.Data.BridgeToken)
+}
