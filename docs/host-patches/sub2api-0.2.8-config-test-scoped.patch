+func TestPluginManagerTestScopedDuplicateWaitHonorsOwnDeadline(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	client := &scopedDiagnosticClient{valid: true}
+	client.testFn = func(ctx context.Context, _ []byte) (*pluginv1.TestConfigResponse, error) {
+		close(entered)
+		select {
+		case <-release:
+			return &pluginv1.TestConfigResponse{Success: true}, nil
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	manager, _ := scopedDiagnosticManager(client)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := manager.TestScoped(ctx, 9, "duplicate-wait", []byte(`{}`)); done <- err }()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("original test did not enter")
+	}
+	waitCtx, waitCancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer waitCancel()
+	_, err := manager.TestScoped(waitCtx, 9, "duplicate-wait", []byte(`{}`))
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	close(release)
+	require.NoError(t, <-done)
+	_, err = manager.TestScoped(context.Background(), 9, "duplicate-wait", []byte(`{}`))
+	require.NoError(t, err)
+	require.Equal(t, int32(1), client.tests.Load())
+}
