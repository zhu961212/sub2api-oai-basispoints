diff --git a/backend/internal/service/plugin_scoped_diagnostics.go b/backend/internal/service/plugin_scoped_diagnostics.go
new file mode 100644
index 0000000000000000000000000000000000000000..b5cd1ddda9ddd2ba992f0f7878afed95fe30542e
--- /dev/null
+++ b/backend/internal/service/plugin_scoped_diagnostics.go
@@ -0,0 +1,168 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"time"
+
+	pluginv1 "github.com/Wei-Shaw/sub2api/pkg/pluginapi/v1"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/protobuf/proto"
+)
+
+const (
+	pluginScopedTestTTL          = 10 * time.Minute
+	pluginScopedTestMaxEntries   = 256
+	pluginScopedTestScopeKey     = "x-sub2api-test-scope"
+	pluginScopedTestRequestIDKey = "x-sub2api-test-request-id"
+)
+
+type pluginScopedTestKey struct {
+	pluginID  int64
+	requestID string
+}
+
+type pluginScopedTestEntry struct {
+	digest  [sha256.Size]byte
+	done    chan struct{}
+	expires time.Time
+	result  *pluginv1.TestConfigResponse
+	err     error
+}
+
+// TestScoped binds a test to one caller-supplied configuration snapshot. It does
+// not load saved configuration, apply configuration, or write any configuration.
+// Request IDs provide bounded, process-local replay protection, including RPC
+// failures where the host cannot know whether an upstream request was sent.
+func (m *PluginManager) TestScoped(ctx context.Context, id int64, requestID string, raw json.RawMessage) (*pluginv1.TestConfigResponse, error) {
+	// Include validation, repository reads and duplicate waits in one budget.
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	if id <= 0 || !validPluginScopedRequestID(requestID) {
+		return nil, errors.New("检测 request_id 无效：须为 1–128 位字母、数字、短横线、下划线、点或冒号")
+	}
+	canonical, err := canonicalPluginScopedConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	key := pluginScopedTestKey{pluginID: id, requestID: requestID}
+	digest := sha256.Sum256(canonical)
+	now := time.Now()
+	m.scopedTestMu.Lock()
+	if m.scopedTests == nil {
+		m.scopedTests = make(map[pluginScopedTestKey]*pluginScopedTestEntry)
+	}
+	for existingKey, entry := range m.scopedTests {
+		// Never evict in-flight operations or unexpired completed results.
+		if !entry.expires.IsZero() && !now.Before(entry.expires) {
+			delete(m.scopedTests, existingKey)
+		}
+	}
+	if entry, exists := m.scopedTests[key]; exists {
+		m.scopedTestMu.Unlock()
+		if entry.digest != digest {
+			return nil, errors.New("检测 request_id 已用于不同配置，请为新的检测使用新的 request_id")
+		}
+		select {
+		case <-entry.done:
+			return clonePluginTestResponse(entry.result), entry.err
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	if len(m.scopedTests) >= pluginScopedTestMaxEntries {
+		m.scopedTestMu.Unlock()
+		return nil, errors.New("检测请求过多，请等待现有检测缓存过期后重试")
+	}
+	entry := &pluginScopedTestEntry{digest: digest, done: make(chan struct{})}
+	m.scopedTests[key] = entry
+	m.scopedTestMu.Unlock()
+
+	result, err := m.testScopedSnapshot(ctx, id, requestID, canonical)
+	m.scopedTestMu.Lock()
+	entry.result, entry.err = clonePluginTestResponse(result), err
+	entry.expires = time.Now().Add(pluginScopedTestTTL)
+	close(entry.done)
+	m.scopedTestMu.Unlock()
+	return result, err
+}
+
+func (m *PluginManager) testScopedSnapshot(ctx context.Context, id int64, requestID string, snapshot []byte) (*pluginv1.TestConfigResponse, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if _, err := m.repo.GetByID(ctx, id); err != nil {
+		return nil, err
+	}
+	m.mu.Lock()
+	runtime := m.runtimes[id]
+	var api pluginv1.TransportPluginClient
+	if runtime != nil && !runtime.draining.Load() {
+		api = runtime.api
+	}
+	m.mu.Unlock()
+	if api == nil {
+		return nil, errors.New("插件未运行，请先启用插件再进行账号检测")
+	}
+	// Keep the published client for this request without holding operationMu.
+	// Saves, other tests and disable must stay responsive. If this runtime is
+	// stopped, its RPC fails and the failure is cached; never retry a new runtime.
+	validation, err := api.ValidateConfig(ctx, &pluginv1.ValidateConfigRequest{ConfigJson: snapshot})
+	if err != nil {
+		return nil, fmt.Errorf("校验检测配置: %w", err)
+	}
+	if !validation.GetValid() {
+		return nil, fmt.Errorf("检测配置无效: %s", validation.GetMessage())
+	}
+	// Reserved metadata is generated here, never copied from HTTP headers.
+	md, _ := metadata.FromOutgoingContext(ctx)
+	md = md.Copy()
+	md.Set(pluginScopedTestScopeKey, "request-v1")
+	md.Set(pluginScopedTestRequestIDKey, requestID)
+	ctx = metadata.NewOutgoingContext(ctx, md)
+	return api.TestConfig(ctx, &pluginv1.TestConfigRequest{ConfigJson: snapshot})
+}
+
+func validPluginScopedRequestID(id string) bool {
+	if len(id) == 0 || len(id) > 128 {
+		return false
+	}
+	for _, char := range id {
+		if char >= 'a' && char <= 'z' || char >= 'A' && char <= 'Z' || char >= '0' && char <= '9' || char == '-' || char == '_' || char == '.' || char == ':' {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func canonicalPluginScopedConfig(raw []byte) ([]byte, error) {
+	if len(raw) == 0 || len(raw) > pluginConfigMaxBytes {
+		return nil, errors.New("检测配置必须是有效且大小受限的 JSON 对象")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	var value map[string]any
+	if err := decoder.Decode(&value); err != nil || value == nil {
+		return nil, errors.New("检测配置 JSON 根节点必须是对象")
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		return nil, errors.New("检测配置只能包含一个 JSON 对象")
+	}
+	return json.Marshal(value)
+}
+
+func clonePluginTestResponse(result *pluginv1.TestConfigResponse) *pluginv1.TestConfigResponse {
+	if result == nil {
+		return nil
+	}
+	return proto.Clone(result).(*pluginv1.TestConfigResponse)
+}
diff --git a/backend/internal/service/plugin_scoped_diagnostics_test.go b/backend/internal/service/plugin_scoped_diagnostics_test.go
