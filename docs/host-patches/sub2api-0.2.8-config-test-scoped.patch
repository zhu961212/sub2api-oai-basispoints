+func TestPluginManagerTestScopedCachesAmbiguousFailureAndCancellation(t *testing.T) {
+	for _, canceled := range []bool{false, true} {
+		t.Run(fmt.Sprint(canceled), func(t *testing.T) {
+			started := make(chan struct{})
+			client := &scopedDiagnosticClient{valid: true}
+			client.testFn = func(ctx context.Context, _ []byte) (*pluginv1.TestConfigResponse, error) {
+				close(started)
+				if canceled {
+					<-ctx.Done()
+					return nil, ctx.Err()
+				}
+				return nil, errors.New("connection lost after dispatch")
+			}
+			manager, _ := scopedDiagnosticManager(client)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				_, err := manager.TestScoped(ctx, 9, "uncertain-request", []byte(`{}`))
+				done <- err
+			}()
+			<-started
+			if canceled {
+				cancel()
+			}
+			firstErr := <-done
+			require.Error(t, firstErr)
+			_, replayErr := manager.TestScoped(context.Background(), 9, "uncertain-request", []byte(`{}`))
+			require.EqualError(t, replayErr, firstErr.Error())
+			require.Equal(t, int32(1), client.tests.Load())
+		})
+	}
+}
