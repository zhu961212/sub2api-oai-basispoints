+func TestPluginManagerTestScopedRunsConcurrentlyWithoutOperationLock(t *testing.T) {
+	entered := make(chan string, 2)
+	releases := map[string]chan struct{}{"first": make(chan struct{}), "second": make(chan struct{})}
+	done := make(chan string, 2)
+	errCh := make(chan error, 2)
+	client := &scopedDiagnosticClient{valid: true}
+	client.testFn = func(ctx context.Context, _ []byte) (*pluginv1.TestConfigResponse, error) {
+		md, _ := metadata.FromOutgoingContext(ctx)
+		id := md.Get(pluginScopedTestRequestIDKey)[0]
+		entered <- id
+		select {
+		case <-releases[id]:
+			return &pluginv1.TestConfigResponse{Success: true}, nil
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	manager, _ := scopedDiagnosticManager(client)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	manager.operationMu.Lock()
+	locked := true
+	defer func() {
+		if locked {
+			manager.operationMu.Unlock()
+		}
+	}()
+	for _, id := range []string{"first", "second"} {
+		go func() {
+			_, err := manager.TestScoped(ctx, 9, id, []byte(`{}`))
+			errCh <- err
+			done <- id
+		}()
+	}
+	for range 2 {
+		select {
+		case <-entered:
+		case <-ctx.Done():
+			t.Fatal("independent scoped tests did not enter RPC concurrently while lifecycle lock was held")
+		}
+	}
+	manager.operationMu.Unlock()
+	locked = false
+	require.True(t, manager.operationMu.TryLock(), "scoped RPC must not occupy the save/disable lock")
+	manager.operationMu.Unlock()
+	close(releases["first"])
+	select {
+	case id := <-done:
+		require.Equal(t, "first", id)
+	case <-ctx.Done():
+		t.Fatal("first test did not complete independently")
+	}
+	require.NoError(t, <-errCh)
+	select {
+	case <-done:
+		t.Fatal("second test completed before its own release")
+	default:
+	}
+	close(releases["second"])
+	select {
+	case id := <-done:
+		require.Equal(t, "second", id)
+	case <-ctx.Done():
+		t.Fatal("second test did not complete")
+	}
+	require.NoError(t, <-errCh)
+	require.Equal(t, int32(2), client.tests.Load())
+}
