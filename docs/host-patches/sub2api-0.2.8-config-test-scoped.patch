@@ -0,0 +1,430 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	pluginv1 "github.com/Wei-Shaw/sub2api/pkg/pluginapi/v1"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+)
+
+type scopedDiagnosticClient struct {
+	pluginv1.TransportPluginClient
+	valid       bool
+	normalized  []byte
+	validations atomic.Int32
+	applies     atomic.Int32
+	tests       atomic.Int32
+	validateFn  func(context.Context) (*pluginv1.ValidateConfigResponse, error)
+	testFn      func(context.Context, []byte) (*pluginv1.TestConfigResponse, error)
+}
+
+func (c *scopedDiagnosticClient) ValidateConfig(ctx context.Context, _ *pluginv1.ValidateConfigRequest, _ ...grpc.CallOption) (*pluginv1.ValidateConfigResponse, error) {
+	c.validations.Add(1)
+	if c.validateFn != nil {
+		return c.validateFn(ctx)
+	}
+	return &pluginv1.ValidateConfigResponse{Valid: c.valid, Message: "fixture validation", NormalizedConfigJson: c.normalized}, nil
+}
+
+type scopedDiagnosticRepository struct {
+	PluginRepository
+	getFn func(context.Context, int64) (*PluginInstallation, error)
+}
+
+func (r *scopedDiagnosticRepository) GetByID(ctx context.Context, id int64) (*PluginInstallation, error) {
+	return r.getFn(ctx, id)
+}
+
+func (c *scopedDiagnosticClient) ApplyConfig(context.Context, *pluginv1.ApplyConfigRequest, ...grpc.CallOption) (*pluginv1.ApplyConfigResponse, error) {
+	c.applies.Add(1)
+	return &pluginv1.ApplyConfigResponse{Applied: true}, nil
+}
+
+func (c *scopedDiagnosticClient) TestConfig(ctx context.Context, req *pluginv1.TestConfigRequest, _ ...grpc.CallOption) (*pluginv1.TestConfigResponse, error) {
+	c.tests.Add(1)
+	if c.testFn != nil {
+		return c.testFn(ctx, req.ConfigJson)
+	}
+	return &pluginv1.TestConfigResponse{Success: true, Message: "fixture result"}, nil
+}
+
+func scopedDiagnosticManager(client *scopedDiagnosticClient) (*PluginManager, *pluginConfigRepository) {
+	installation := &PluginInstallation{ID: 9, ConfigEncrypted: `ENC:{"target":99}`}
+	repo := &pluginConfigRepository{installation: installation}
+	return &PluginManager{repo: repo, encryptor: pluginTokenEncryptor{}, runtimes: map[int64]*pluginRuntime{9: {installation: installation, api: client}}}, repo
+}
+
+func TestPluginManagerTestScopedBindsSnapshotWithoutApplyOrSave(t *testing.T) {
+	client := &scopedDiagnosticClient{valid: true, normalized: []byte(`{"target":88}`)}
+	manager, repo := scopedDiagnosticManager(client)
+	repo.installation.ConfigEncrypted = "deliberately cannot be decrypted"
+	client.testFn = func(ctx context.Context, snapshot []byte) (*pluginv1.TestConfigResponse, error) {
+		require.JSONEq(t, `{"target":9007199254740993,"degradation_check":true}`, string(snapshot))
+		md, ok := metadata.FromOutgoingContext(ctx)
+		require.True(t, ok)
+		require.Equal(t, []string{"request-v1"}, md.Get(pluginScopedTestScopeKey))
+		require.Equal(t, []string{"request-1"}, md.Get(pluginScopedTestRequestIDKey))
+		require.Equal(t, []string{"trace-1"}, md.Get("trace-id"))
+		return &pluginv1.TestConfigResponse{Success: true, Message: "snapshot result"}, nil
+	}
+	ctx := metadata.NewOutgoingContext(context.Background(), metadata.Pairs(pluginScopedTestScopeKey, "untrusted", pluginScopedTestRequestIDKey, "wrong", "trace-id", "trace-1"))
+	result, err := manager.TestScoped(ctx, 9, "request-1", []byte(`{"target":9007199254740993,"degradation_check":true}`))
+	require.NoError(t, err)
+	require.True(t, result.Success)
+	require.Equal(t, int32(1), client.validations.Load())
+	require.Zero(t, client.applies.Load())
+	require.Empty(t, repo.encrypted)
+	require.Equal(t, "deliberately cannot be decrypted", repo.installation.ConfigEncrypted)
+	result.Message = "caller changed its result"
+	replay, err := manager.TestScoped(ctx, 9, "request-1", []byte(`{ "degradation_check":true, "target":9007199254740993 }`))
+	require.NoError(t, err)
+	require.Equal(t, "snapshot result", replay.Message)
+	require.Equal(t, int32(1), client.tests.Load())
+}
+
+func TestPluginManagerTestScopedDeduplicatesConcurrentRequestsAndRejectsConflicts(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	client := &scopedDiagnosticClient{valid: true}
+	client.testFn = func(context.Context, []byte) (*pluginv1.TestConfigResponse, error) {
+		close(started)
+		<-release
+		return &pluginv1.TestConfigResponse{Success: true}, nil
+	}
+	manager, _ := scopedDiagnosticManager(client)
+	var wg sync.WaitGroup
+	errs := make(chan error, 9)
+	for i := 0; i < 8; i++ {
+		wg.Go(func() {
+			_, err := manager.TestScoped(context.Background(), 9, "same-request", []byte(`{"target":1}`))
+			errs <- err
+		})
+	}
+	<-started
+	_, err := manager.TestScoped(context.Background(), 9, "same-request", []byte(`{"target":2}`))
+	require.ErrorContains(t, err, "不同配置")
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = manager.TestScoped(canceledCtx, 9, "same-request", []byte(`{"target":1}`))
+	require.ErrorIs(t, err, context.Canceled)
+	close(release)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	require.Equal(t, int32(1), client.tests.Load())
+	require.Equal(t, int32(1), client.validations.Load())
+}
+
+func TestPluginManagerTestScopedKeepsDifferentTargetsIndependent(t *testing.T) {
+	client := &scopedDiagnosticClient{valid: true}
+	client.testFn = func(ctx context.Context, snapshot []byte) (*pluginv1.TestConfigResponse, error) {
+		md, _ := metadata.FromOutgoingContext(ctx)
+		return &pluginv1.TestConfigResponse{Success: true, Message: md.Get(pluginScopedTestRequestIDKey)[0], StatusJson: string(snapshot)}, nil
+	}
+	manager, repo := scopedDiagnosticManager(client)
+	var wg sync.WaitGroup
+	for id := 1; id <= 2; id++ {
+		wg.Go(func() {
+			requestID := fmt.Sprintf("page-%d", id)
